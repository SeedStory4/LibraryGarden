<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="libraryGarden.user.mapper.UserMapper">

    <!-- 회원 가입 -->
    <insert id="insertUser" parameterType="libraryGarden.domain.UserVo">
        INSERT INTO USER (
            id, password, name, phone, email, address, userNumber
        ) VALUES (
            #{id}, #{password}, #{name}, #{phone}, #{email}, #{address}, #{userNumber}
        )
    </insert>

    <!-- 아이디 중복 확인 -->
    <select id="countUserById" parameterType="String" resultType="int">
        SELECT COUNT(*) FROM USER WHERE id = #{id}
    </select>
    
    <!-- 마지막 userNumber 조회 -->
	<select id="getLastUserNumber" resultType="String">
	    SELECT MAX(userNumber) FROM USER
	</select>
	
	<select id="login" parameterType="string" resultType="libraryGarden.domain.UserVo">
	    SELECT *
	    FROM USER
	    WHERE ID = #{id}
	</select>

	
	<select id="selectUserById" resultType="libraryGarden.domain.UserVo" parameterType="String">
	  SELECT * FROM USER WHERE ID = #{id}
	</select>
	
	<update id="updateUser" parameterType="libraryGarden.domain.UserVo">
	    UPDATE USER
	    SET password = #{password},
	        phone = #{phone},
	        email = #{email},
	        address = #{address}
	    WHERE id = #{id}
	</update>
	
	

</mapper>
