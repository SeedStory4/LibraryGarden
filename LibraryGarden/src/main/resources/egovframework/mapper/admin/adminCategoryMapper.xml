<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="libraryGarden.admin.mapper.AdminCategoryMapper">
	
	<!-- 관리자 도서 등록/수정을 위한 카테고리 중 대분류 가지고 오는 메서드 -->
	<select id="getParentCategoryByLevel" resultType="lbd">
	    SELECT * FROM CATEGORY WHERE level = #{level}
	</select>
	
	<!-- 관리자 도서 등록/수정을 위한 카테고리 중 소분류 가지고 오는 메서드 -->
	<select id="getChildrenCategoryByparentCode" resultType="lbd">
    	SELECT * FROM CATEGORY WHERE parentCode = #{parentCode} AND level = 2
	</select>
	
</mapper>