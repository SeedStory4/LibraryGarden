<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="libraryGarden.admin.mapper.AdminBookRequestMapper">
	
	<!-- 자바처럼 sql문과 java를 섞어서 사용할 수 없어서 include해서 사용한다 -->
	<sql id="search">
		<if test="searchType != null and searchType.equals('title')">
			AND B.title LIKE CONCAT('%',#{keyword},'%')
		</if>
		<if test="searchType != null and searchType.equals('author')">
			AND B.author LIKE CONCAT('%',#{keyword},'%')
		</if>
		<if test="searchType != null and searchType.equals('name')">
			AND U.name LIKE CONCAT('%',#{keyword},'%')
		</if>
	</sql>
	
  	<select id="bookRequestTotalCount" parameterType="HashMap" resultType="int">
		SELECT COUNT(*) AS cnt 
		FROM REQUEST AS RQ 
		JOIN USER AS U ON RQ.uidx = U.uidx 
		JOIN BOOKS AS B ON RQ.bidx = B.bidx 
		WHERE RQ.delyn = 'N' 
		<include refid="search"/>
	</select>
	
 	<select id="bookRequestSelectAll" parameterType="HashMap" resultType="rd">
		SELECT B.coverImg, B.title, B.author, B.publisher, U.name, U.userNumber, RQ.rqidx, RQ.regDate  
		<!-- REQUEST 테이블의 uidx와 USER 테이블의 uidx를 JOIN하여 USER 정보를 가져온다. -->
		FROM REQUEST AS RQ 
		JOIN USER AS U ON RQ.uidx = U.uidx 
		<!-- REQUEST 테이블의 bidx와 BOOKS 테이블의 bidx를 JOIN하여 BOOK 정보를 가져온다. -->
		JOIN BOOKS AS B ON RQ.bidx = B.bidx 
		WHERE RQ.delyn = 'N' 
		<include refid="search"/>
		ORDER BY RQ.rqidx LIMIT #{startPageNum}, #{perPageNum};
	</select>
	
</mapper>